<!-- 工艺 -->
{% header %}
<style>
.section-mtmzh6pr {
  font-family: Georgia, "Times New Roman", serif;
  color: #1c2a25;
}

.section-mtmzh6pr .ax-finish {
  position: relative;
  padding: 88px 0 84px;
  background: #e8e4d5;
  color: #1c2a25;
}

.section-mtmzh6pr .ax-finish__layout {
  display: flex;
  align-items: center;
}

.section-mtmzh6pr .ax-finish__photo {
  position: relative;
  margin: 0;
}

.section-mtmzh6pr .ax-finish__photo::before {
  content: "";
  position: absolute;
  inset: 22px -20px -20px 20px;
  border: 1px solid rgba(214, 148, 53, 0.6);
  z-index: 0;
}

.section-mtmzh6pr .ax-finish__photo img {
  position: relative;
  z-index: 1;
  display: block;
  width: 100%;
  height: 460px;
  object-fit: cover;
  box-shadow: 0 30px 70px rgba(28, 42, 37, 0.28);
}

.section-mtmzh6pr .ax-finish__kicker {
  margin: 0 0 18px;
  color: #a8641c;
  font-family: "Lucida Console", Monaco, monospace;
  font-size: 12px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.section-mtmzh6pr .ax-finish__title {
  margin: 0 0 34px;
  color: #1c2a25;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 42px;
  font-weight: 400;
  line-height: 1.12;
}

.section-mtmzh6pr .ax-finish__list {
  border-top: 1px solid rgba(28, 42, 37, 0.18);
}

.section-mtmzh6pr .ax-finish__item {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 10px;
  padding: 22px 0;
  border-bottom: 1px solid rgba(28, 42, 37, 0.18);
}

.section-mtmzh6pr .ax-finish__item span {
  flex: 0 0 42%;
  font-size: 18px;
  color: #1c2a25;
}

.section-mtmzh6pr .ax-finish__item p {
  flex: 1 1 auto;
  margin: 0;
  color: #55645c;
  font-size: 14.5px;
  line-height: 1.7;
}
</style>
{% endheader %}

<div class="section-mtmzh6pr">
  <section class="ax-finish">
    <div class="container">
      <div class="row ax-finish__layout">
        <div class="col-md-5 col-sm-5">
          {% if this.Model.image %}
          <figure class="ax-finish__photo">
            <img property="true" data-property="image" method="attr" para="src" src="{% url this.Model.image %}" alt="台灯金属关节细节">
          </figure>
          {% endif %}
        </div>
        <div class="col-md-6 col-md-offset-1 col-sm-7">
          {% if this.Model.kicker %}
          <p class="ax-finish__kicker" property="true" data-property="kicker" method="text">{{this.Model.kicker}}</p>
          {% endif %}
          {% if this.Model.title %}
          <h2 class="ax-finish__title" property="true" data-property="title" method="text">{{this.Model.title}}</h2>
          {% endif %}
          {% if this.Model.items %}
          <div class="ax-finish__list">
            {% for item in this.Model.items %}
            {% assign index = forloop.index0 %}
            <article class="ax-finish__item">
              {% if item.heading %}
              <span property="true" data-property="items[{{index}}].heading" method="text">{{item.heading}}</span>
              {% endif %}
              {% if item.text %}
              <p property="true" data-property="items[{{index}}].text" method="text">{{item.text}}</p>
              {% endif %}
            </article>
            {% endfor %}
          </div>
          {% endif %}
        </div>
      </div>
    </div>
  </section>
</div>
