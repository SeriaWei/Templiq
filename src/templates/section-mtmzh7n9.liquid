<!-- 套装 -->
{% header %}
<style>
.section-mtmzh7n9 {
  font-family: Georgia, "Times New Roman", serif;
  color: #e7e3d4;
}

.section-mtmzh7n9 .ax-lineup {
  position: relative;
  padding: 88px 0 90px;
  background:
    linear-gradient(90deg, rgba(231, 227, 212, 0.05) 1px, transparent 1px) 0 0 / 56px 56px,
    linear-gradient(0deg, rgba(231, 227, 212, 0.05) 1px, transparent 1px) 0 0 / 56px 56px,
    #0e1a17;
  color: #e7e3d4;
}

.section-mtmzh7n9 .ax-lineup__intro {
  margin-bottom: 48px;
}

.section-mtmzh7n9 .ax-lineup__kicker {
  margin: 0 0 18px;
  color: #d69435;
  font-family: "Lucida Console", Monaco, monospace;
  font-size: 12px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.section-mtmzh7n9 .ax-lineup__title {
  margin: 0;
  color: #f5f1e2;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 42px;
  font-weight: 400;
  line-height: 1.1;
}

.section-mtmzh7n9 .ax-lineup__text {
  margin: 10px 0 0;
  color: #9fb0a4;
  font-size: 16px;
  line-height: 1.8;
}

.section-mtmzh7n9 .ax-lineup__item {
  height: 100%;
  border: 1px solid rgba(231, 227, 212, 0.16);
  background: rgba(20, 38, 33, 0.6);
}

.section-mtmzh7n9 .ax-lineup__image {
  overflow: hidden;
}

.section-mtmzh7n9 .ax-lineup__image img {
  display: block;
  width: 100%;
  height: 300px;
  object-fit: cover;
  filter: saturate(1.04) contrast(1.04);
  transition: transform 500ms ease;
}

.section-mtmzh7n9 .ax-lineup__item:hover .ax-lineup__image img {
  transform: scale(1.04);
}

.section-mtmzh7n9 .ax-lineup__detail {
  padding: 26px 28px 30px;
}

.section-mtmzh7n9 .ax-lineup__detail span {
  color: #d69435;
  font-family: "Lucida Console", Monaco, monospace;
  font-size: 12px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.section-mtmzh7n9 .ax-lineup__detail h3 {
  margin: 10px 0 12px;
  color: #f5f1e2;
  font-size: 24px;
  font-weight: 400;
}

.section-mtmzh7n9 .ax-lineup__detail p {
  margin: 0;
  color: #8f9f93;
  font-size: 15px;
  line-height: 1.7;
}

.section-mtmzh7n9 .ax-lineup__detail strong {
  display: block;
  margin-top: 20px;
  color: #d69435;
  font-family: "Lucida Console", Monaco, monospace;
  font-size: 22px;
  font-weight: 400;
  letter-spacing: 0.02em;
}

.section-mtmzh7n9 .ax-lineup__item--dark {
  background: #101f1a;
}
</style>
{% endheader %}

<div class="section-mtmzh7n9">
  <section class="ax-lineup">
    <div class="container">
      <div class="row ax-lineup__intro">
        <div class="col-md-6">
          {% if this.Model.kicker %}
          <p class="ax-lineup__kicker" property="true" data-property="kicker" method="text">{{this.Model.kicker}}</p>
          {% endif %}
          {% if this.Model.title %}
          <h2 class="ax-lineup__title" property="true" data-property="title" method="text">{{this.Model.title}}</h2>
          {% endif %}
        </div>
        <div class="col-md-5 col-md-offset-1">
          {% if this.Model.text %}
          <p class="ax-lineup__text" property="true" data-property="text" method="text">{{this.Model.text}}</p>
          {% endif %}
        </div>
      </div>
      {% if this.Model.items %}
      <div class="row ax-lineup__cards">
        {% for item in this.Model.items %}
        {% assign index = forloop.index0 %}
        <div class="col-md-6 col-sm-6">
          <article class="ax-lineup__item{% if item.is_dark == 'true' %} ax-lineup__item--dark{% endif %}">
            {% if item.image %}
            <div class="ax-lineup__image">
              <img property="true" data-property="items[{{index}}].image" method="attr" para="src" src="{% url item.image %}" alt="{{item.name}}">
            </div>
            {% endif %}
            <div class="ax-lineup__detail">
              {% if item.badge %}
              <span property="true" data-property="items[{{index}}].badge" method="text">{{item.badge}}</span>
              {% endif %}
              {% if item.name %}
              <h3 property="true" data-property="items[{{index}}].name" method="text">{{item.name}}</h3>
              {% endif %}
              {% if item.description %}
              <p property="true" data-property="items[{{index}}].description" method="text">{{item.description}}</p>
              {% endif %}
              {% if item.price %}
              <strong property="true" data-property="items[{{index}}].price" method="text">{{item.price}}</strong>
              {% endif %}
            </div>
          </article>
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </section>
</div>
