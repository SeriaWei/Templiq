<!-- 悬臂 -->
{% header %}
<style>
.section-mtmzh5ri {
  font-family: Georgia, "Times New Roman", serif;
  color: #e7e3d4;
}

.section-mtmzh5ri .ax-arm {
  position: relative;
  padding: 88px 0 84px;
  background:
    linear-gradient(90deg, rgba(231, 227, 212, 0.05) 1px, transparent 1px) 0 0 / 56px 56px,
    linear-gradient(0deg, rgba(231, 227, 212, 0.05) 1px, transparent 1px) 0 0 / 56px 56px,
    #0e1a17;
  color: #e7e3d4;
}

.section-mtmzh5ri .ax-arm__kicker {
  margin: 0 0 18px;
  color: #d69435;
  font-family: "Lucida Console", Monaco, monospace;
  font-size: 12px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.section-mtmzh5ri .ax-arm__title {
  margin: 0;
  color: #f5f1e2;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 44px;
  font-weight: 400;
  line-height: 1.12;
}

.section-mtmzh5ri .ax-arm__text {
  margin: 26px 0 0;
  color: #9fb0a4;
  font-size: 16px;
  line-height: 1.85;
}

.section-mtmzh5ri .ax-arm__steps {
  border-top: 1px solid rgba(231, 227, 212, 0.14);
  margin-top: 8px;
}

.section-mtmzh5ri .ax-arm__step {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  padding: 30px 0;
  border-bottom: 1px solid rgba(231, 227, 212, 0.14);
}

.section-mtmzh5ri .ax-arm__step-index {
  flex: 0 0 64px;
  color: #d69435;
  font-family: "Lucida Console", Monaco, monospace;
  font-size: 12px;
  letter-spacing: 0.06em;
}

.section-mtmzh5ri .ax-arm__step h3 {
  flex: 0 0 38%;
  margin: 0;
  color: #f5f1e2;
  font-size: 20px;
  font-weight: 400;
}

.section-mtmzh5ri .ax-arm__step p {
  flex: 1 1 auto;
  margin: 0;
  color: #8f9f93;
  font-size: 15px;
  line-height: 1.7;
}
</style>
{% endheader %}

<div class="section-mtmzh5ri">
  <section class="ax-arm">
    <div class="container">
      <div class="row">
        <div class="col-md-4 col-sm-4">
          <div class="ax-arm__heading">
            {% if this.Model.kicker %}
            <p class="ax-arm__kicker" property="true" data-property="kicker" method="text">{{this.Model.kicker}}</p>
            {% endif %}
            {% if this.Model.title %}
            <h2 class="ax-arm__title" property="true" data-property="title" method="text">{{this.Model.title}}</h2>
            {% endif %}
            {% if this.Model.text %}
            <p class="ax-arm__text" property="true" data-property="text" method="text">{{this.Model.text}}</p>
            {% endif %}
          </div>
        </div>
        <div class="col-md-8 col-sm-8">
          {% if this.Model.steps %}
          <div class="ax-arm__steps">
            {% for step in this.Model.steps %}
            {% assign index = forloop.index0 %}
            <article class="ax-arm__step">
              {% if step.number %}
              <span class="ax-arm__step-index" property="true" data-property="steps[{{index}}].number" method="text">{{step.number}}</span>
              {% endif %}
              {% if step.heading %}
              <h3 property="true" data-property="steps[{{index}}].heading" method="text">{{step.heading}}</h3>
              {% endif %}
              {% if step.text %}
              <p property="true" data-property="steps[{{index}}].text" method="text">{{step.text}}</p>
              {% endif %}
            </article>
            {% endfor %}
          </div>
          {% endif %}
        </div>
      </div>
    </div>
  </section>
</div>
