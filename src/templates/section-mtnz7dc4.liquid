<!-- 胶片配方 -->
{% header %}
<style>
.section-mtnz7dc4 {
    position: relative;
    overflow: hidden;
    padding: 96px 0 100px;
    background: #efe7d8;
    color: #17130f;
    font-family: Georgia, "Times New Roman", serif;
}
.section-mtnz7dc4 .dm-film__rule {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 6px;
    background: repeating-linear-gradient(90deg, #17130f 0 26px, transparent 26px 40px);
}
.section-mtnz7dc4 .dm-film__intro {
    display: flex;
    align-items: flex-end;
    margin-bottom: 58px;
}
.section-mtnz7dc4 .dm-film__intro .col-md-6 {
    padding-right: 30px;
}
.section-mtnz7dc4 .dm-film__kicker {
    margin: 0 0 16px;
    color: #a8542a;
    font-family: "Lucida Console", Monaco, monospace;
    font-size: 13px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
}
.section-mtnz7dc4 .dm-film__title {
    margin: 0;
    max-width: 620px;
    color: #17130f;
    font-family: Didot, "Bodoni 72", Georgia, serif;
    font-size: 54px;
    font-weight: 400;
    line-height: 1.02;
}
.section-mtnz7dc4 .dm-film__text {
    margin: 0;
    color: #4a4438;
    font-size: 17px;
    line-height: 1.85;
}
.section-mtnz7dc4 .dm-film__grid {
    display: flex;
    flex-wrap: wrap;
    margin: 0 -14px;
}
.section-mtnz7dc4 .dm-film__grid > [class*="col-"] {
    padding: 0 14px;
}
.section-mtnz7dc4 .dm-film__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid rgba(23, 19, 15, 0.16);
    background: #f7f1e4;
}
.section-mtnz7dc4 .dm-film__card--dark {
    border-color: #17130f;
    background: #17130f;
    color: #efe7d8;
}
.section-mtnz7dc4 .dm-film__card--dark .dm-film__name {
    color: #f4ecdd;
}
.section-mtnz7dc4 .dm-film__card--dark .dm-film__note {
    color: #a89e8c;
}
.section-mtnz7dc4 .dm-film__card--dark .dm-film__row {
    border-color: rgba(239, 231, 216, 0.14);
}
.section-mtnz7dc4 .dm-film__card--dark .dm-film__row b {
    color: #f4ecdd;
}
.section-mtnz7dc4 .dm-film__card--dark .dm-film__tag {
    border-color: rgba(224, 122, 60, 0.6);
    background: rgba(224, 122, 60, 0.12);
    color: #e8a06a;
}
.section-mtnz7dc4 .dm-film__swatch {
    position: relative;
    height: 240px;
    overflow: hidden;
}
.section-mtnz7dc4 .dm-film__swatch img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9) contrast(1.04);
}
.section-mtnz7dc4 .dm-film__swatch--cool img {
    filter: saturate(0.55) contrast(1.08) brightness(1.02);
}
.section-mtnz7dc4 .dm-film__swatch--warm img {
    filter: saturate(1.06) contrast(1.06) sepia(0.12);
}
.section-mtnz7dc4 .dm-film__swatch--mono img {
    filter: grayscale(1) contrast(1.14);
}
.section-mtnz7dc4 .dm-film__swatch span {
    position: absolute;
    left: 16px;
    top: 16px;
    padding: 7px 11px;
    background: rgba(11, 9, 6, 0.72);
    color: #f4ecdd;
    font-family: "Lucida Console", Monaco, monospace;
    font-size: 12px;
    letter-spacing: 0.06em;
}
.section-mtnz7dc4 .dm-film__body {
    flex: 1 1 auto;
    padding: 26px 26px 28px;
}
.section-mtnz7dc4 .dm-film__tag {
    display: inline-block;
    margin-bottom: 14px;
    padding: 6px 11px;
    border: 1px solid rgba(168, 84, 42, 0.5);
    background: rgba(168, 84, 42, 0.08);
    color: #a8542a;
    font-family: "Lucida Console", Monaco, monospace;
    font-size: 11px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
}
.section-mtnz7dc4 .dm-film__name {
    margin: 0 0 10px;
    color: #17130f;
    font-family: Didot, "Bodoni 72", Georgia, serif;
    font-size: 28px;
    font-weight: 400;
    line-height: 1.1;
}
.section-mtnz7dc4 .dm-film__note {
    margin: 0 0 22px;
    color: #4a4438;
    font-size: 15px;
    line-height: 1.7;
}
.section-mtnz7dc4 .dm-film__specs {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgba(23, 19, 15, 0.14);
}
.section-mtnz7dc4 .dm-film__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    padding: 11px 0;
    border-bottom: 1px solid rgba(23, 19, 15, 0.14);
    font-size: 14px;
}
.section-mtnz7dc4 .dm-film__row span {
    color: #7d7462;
    font-family: "Lucida Console", Monaco, monospace;
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
}
.section-mtnz7dc4 .dm-film__row b {
    font-weight: 400;
    color: #17130f;
}
@media (max-width: 991px) {
    .section-mtnz7dc4 {
        padding: 66px 0 70px;
    }
    .section-mtnz7dc4 .dm-film__intro {
        display: block;
        margin-bottom: 40px;
    }
    .section-mtnz7dc4 .dm-film__intro .col-md-6 {
        padding-right: 0;
    }
    .section-mtnz7dc4 .dm-film__text {
        margin-top: 22px;
    }
    .section-mtnz7dc4 .dm-film__title {
        font-size: 42px;
    }
    .section-mtnz7dc4 .dm-film__grid > [class*="col-"] {
        width: 100% !important;
        margin-bottom: 22px;
    }
}
@media (max-width: 640px) {
    .section-mtnz7dc4 .dm-film__title {
        font-size: 34px;
    }
    .section-mtnz7dc4 .dm-film__text {
        font-size: 16px;
    }
    .section-mtnz7dc4 .dm-film__swatch {
        height: 200px;
    }
    .section-mtnz7dc4 .dm-film__body {
        padding: 22px 20px 24px;
    }
    .section-mtnz7dc4 .dm-film__name {
        font-size: 23px;
    }
}
</style>
{% endheader %}

<section class="section-mtnz7dc4">
    <div class="dm-film__rule" aria-hidden="true"></div>
    <div class="container">
        <div class="row dm-film__intro">
            <div class="col-md-6">
                {% if this.Model.kicker %}
                <p class="dm-film__kicker" property="true" data-property="kicker" method="text">{{this.Model.kicker}}</p>
                {% endif %}
                {% if this.Model.title %}
                <h2 class="dm-film__title" property="true" data-property="title" method="text">{{this.Model.title}}</h2>
                {% endif %}
            </div>
            <div class="col-md-6">
                {% if this.Model.text %}
                <p class="dm-film__text" property="true" data-property="text" method="text">{{this.Model.text}}</p>
                {% endif %}
            </div>
        </div>

        {% if this.Model.stocks.size > 0 %}
        <div class="row dm-film__grid">
            {% for stock in this.Model.stocks %}
            {% assign stock_index = forloop.index0 %}
            <div class="col-md-4">
                <article class="dm-film__card{% if stock.tone == 'warm' %} dm-film__card--dark{% endif %}">
                    {% if stock.image %}
                    <div class="dm-film__swatch{% if stock.tone %} dm-film__swatch--{{stock.tone}}{% endif %}">
                        <img property="true" data-property="stocks[{{stock_index}}].image" method="attr" para="src" src="{% url stock.image %}" {% if stock.image_alt %}alt="{{stock.image_alt}}"{% endif %}>
                        {% if stock.frame %}
                        <span property="true" data-property="stocks[{{stock_index}}].frame" method="text">{{stock.frame}}</span>
                        {% endif %}
                    </div>
                    {% endif %}
                    <div class="dm-film__body">
                        {% if stock.tag %}
                        <span class="dm-film__tag" property="true" data-property="stocks[{{stock_index}}].tag" method="text">{{stock.tag}}</span>
                        {% endif %}
                        {% if stock.name %}
                        <h3 class="dm-film__name" property="true" data-property="stocks[{{stock_index}}].name" method="text">{{stock.name}}</h3>
                        {% endif %}
                        {% if stock.note %}
                        <p class="dm-film__note" property="true" data-property="stocks[{{stock_index}}].note" method="text">{{stock.note}}</p>
                        {% endif %}
                        {% if stock.specs.size > 0 %}
                        <ul class="dm-film__specs">
                            {% for spec in stock.specs %}
                            <li class="dm-film__row">
                                {% if spec.key %}<span property="true" data-property="stocks[{{stock_index}}].specs[{{forloop.index0}}].key" method="text">{{spec.key}}</span>{% endif %}
                                {% if spec.val %}<b property="true" data-property="stocks[{{stock_index}}].specs[{{forloop.index0}}].val" method="text">{{spec.val}}</b>{% endif %}
                            </li>
                            {% endfor %}
                        </ul>
                        {% endif %}
                    </div>
                </article>
            </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>
</section>
